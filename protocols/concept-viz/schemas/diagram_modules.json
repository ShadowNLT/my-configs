{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concept-viz.local/schemas/diagram_modules.json",
  "title": "DiagramModules",
  "type": "object",
  "required": ["modules"],
  "additionalProperties": false,
  "properties": {
    "modules": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "title", "fragment", "layout"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "fragment": { "type": "string" },
          "layout": { "type": "string" }
        }
      }
    }
  }
}
